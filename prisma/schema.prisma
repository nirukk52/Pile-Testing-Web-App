generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Project-level container for multiple tests.
/// Why: Groups tests by construction project, stores common client/contractor info.
model Project {
  id         String   @id @default(uuid())
  name       String
  client     String
  contractor String
  pmc        String?
  location   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tests      Test[]
}

/// A single pile load test instance.
/// Why: Core entity containing pile specs, equipment info, and test state.
model Test {
  id                String                   @id @default(uuid())
  projectId         String
  testType          TestType                 @default(IVPLT)
  reportNo          String?
  testDate          DateTime                 @default(now())
  pileId            String
  pileDiameterMm    Float
  pileDepthM        Float
  concreteGrade     String
  designLoadT       Float
  testLoadT         Float
  jackName          String?
  ramAreaCm2        Float
  gaugeLeastCountMm Float                    @default(0.01)
  status            TestStatus               @default(DRAFT)
  maxSettlementMm   Float?
  elasticReboundMm  Float?
  netSettlementMm   Float?
  safeLoadAdoptedT  Float?
  isPassed          Boolean?
  conclusion        String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  dateOfCasting     DateTime?
  slug              String?                  @unique
  certificates      CalibrationCertificate[]
  fieldReadings     FieldReading[]
  readings          Reading[]
  siteImages        SiteImage[]
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([testType])
  @@index([slug])
}

/// A single measurement during the test.
/// Why: Captures time-stamped pressure/settlement data with gauge status.
model Reading {
  id              String    @id @default(uuid())
  testId          String
  sequence        Int
  phase           TestPhase
  recordedAt      DateTime  @default(now())
  pressureKgCm2   Float
  loadT           Float
  dg1             Float
  dg2             Float
  dg3             Float
  dg4             Float
  dg1Enabled      Boolean   @default(true)
  dg2Enabled      Boolean   @default(true)
  dg3Enabled      Boolean   @default(true)
  dg4Enabled      Boolean   @default(true)
  avgSettlementMm Float
  remark          String?
  createdAt       DateTime  @default(now())
  test            Test      @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, sequence])
  @@index([testId])
}

/// Site photo attached to a test.
/// Why: Visual documentation of test setup for report inclusion.
model SiteImage {
  id           String   @id @default(uuid())
  testId       String
  storagePath  String
  fileName     String
  caption      String?
  displayOrder Int
  createdAt    DateTime @default(now())
  test         Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

/// Calibration certificate PDF attached to a test.
/// Why: Appended to final report for IS 2911 compliance documentation.
model CalibrationCertificate {
  id              String          @id @default(uuid())
  testId          String
  certificateType CertificateType @default(OTHER)
  storagePath     String
  fileName        String
  createdAt       DateTime        @default(now())
  test            Test            @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

/// Field reading PDF (scanned handwritten field sheets) attached to a test.
/// Why: Original handwritten records are included in final report as reference documentation.
model FieldReading {
  id          String   @id @default(uuid())
  testId      String
  storagePath String
  fileName    String
  createdAt   DateTime @default(now())
  test        Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

/// User profile for signatures and identification.
/// Why: Stores engineer name for report attribution.
model UserProfile {
  id          String   @id @default(uuid())
  name        String
  email       String?  @unique
  company     String?
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model beta_signups {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_content  String?
  utm_term     String?
  landing_url  String?
  referrer     String?
  user_agent   String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([utm_campaign, utm_content], map: "idx_beta_signups_campaign")
  @@index([created_at], map: "idx_beta_signups_created")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model marketing_events {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type   String
  utm_source   String?
  utm_medium   String?
  utm_campaign String?
  utm_content  String?
  utm_term     String?
  element_id   String?
  element_text String?
  page_url     String?
  referrer     String?
  session_id   String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([utm_campaign, utm_content], map: "idx_marketing_events_campaign")
  @@index([created_at], map: "idx_marketing_events_created")
  @@index([session_id], map: "idx_marketing_events_session")
  @@index([event_type], map: "idx_marketing_events_type")
}

/// Types of pile load tests supported by the system.
/// Why: Enables Test Type Engine pattern for polymorphic behavior.
enum TestType {
  IVPLT
  RVPLT
  LATERAL
  UPLIFT
}

/// Phases during a pile load test.
/// Why: Readings are grouped by phase for display and graph rendering.
enum TestPhase {
  LOADING
  HOLD
  UNLOADING
}

/// Status of a test throughout its lifecycle.
/// Why: Controls UI flow and report generation eligibility.
enum TestStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  REPORTED
}

/// Types of calibration certificates.
/// Why: Certificates are categorized for proper ordering in final report.
enum CertificateType {
  HYDRAULIC_JACK
  PRESSURE_GAUGE
  DIAL_GAUGE
  PROVING_RING
  OTHER
}
