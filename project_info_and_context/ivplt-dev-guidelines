## 2\. Database Schema (Supabase/Prisma)

Based on the entities defined in `spec.md`, use this schema structure.

```prisma
model Project {
  id            String   @id @default(uuid())
  name          String
  client        String
  contractor    String
  pmc           String   // Project Management Consultant
  location      String
  tests         Test[]
}

model Test {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id])
  type            TestType @default(IVPLT)
  
  // Pile Specs
  pileId          String
  pileDiameterMm  Float
  pileDepthM      Float
  concreteGrade   String
  designLoadT     Float
  testLoadT       Float    // Should default to 2.5 * designLoadT
  
  // Equipment Specs
  jackName        String
  ramAreaCm2      Float
  gaugeLeastCountMm Float
  
  // State
  status          TestStatus @default(DRAFT)
  readings        Reading[]
  images          SiteImage[]
  certificates    CalibrationCertificate[]
  
  // Computed Results (Cached)
  maxSettlement   Float?
  netSettlement   Float?
  isPassed        Boolean?
  conclusion      String?  // AI Generated
}

model Reading {
  id              String   @id @default(uuid())
  testId          String
  test            Test     @relation(fields: [testId], references: [id])
  sequence        Int
  phase           TestPhase // LOADING, HOLD, UNLOADING
  
  timeRecorded    DateTime
  pressureKgCm2   Float
  loadT           Float    // Stored to ensure historical accuracy if Ram Area changes
  
  // Gauge Readings
  dg1             Float
  dg2             Float
  dg3             Float
  dg4             Float
  
  // Gauge Status (True = Working, False = Faulty)
  dg1Enabled      Boolean @default(true)
  dg2Enabled      Boolean @default(true)
  dg3Enabled      Boolean @default(true)
  dg4Enabled      Boolean @default(true)
  
  avgSettlement   Float
  remarks         String?
}

enum TestPhase {
  LOADING
  HOLD
  UNLOADING
}
```

